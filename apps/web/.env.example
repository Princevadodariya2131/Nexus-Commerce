# Next.js frontend environment (copy to apps/web/.env.local for local overrides).
# Local development works without any of these: the API client defaults to http://localhost:4000/api/v1.
# Placeholders only. Never commit real values.

# Build-time. Local default: http://localhost:4000/api/v1
# On Vercel use /api/v1 together with API_PROXY_TARGET (the build fails if this is missing).
NEXT_PUBLIC_API_URL=

# Server-side only, no trailing slash. Forwards /api/v1/* from the web origin to the API host.
# Example shape: https://your-api-host.example.com   (leave empty for local development)
API_PROXY_TARGET=

# Show the demo login hint (customer@demo.com / Customer@123) in a PRODUCTION build. Leave unset on a real site.
# It is always shown in local development.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=
