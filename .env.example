# ===========================================
# NEXUS COMMERCE - Environment Configuration
# ===========================================

# Application
NODE_ENV=development
APP_NAME=Nexus Commerce

# API Server
PORT=4000
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
# Number of reverse proxies in front of the API (affects client-IP detection / rate limiting).
TRUST_PROXY_HOPS=1

# Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Note: the current code does not use WebSockets on the client; this value is reserved.
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Vercel / split hosting (web and API on different domains):
#   NEXT_PUBLIC_API_URL=/api/v1                      (same-origin path; keeps auth cookies first-party)
#   API_PROXY_TARGET=https://<your-api-host>         (server-side only, no trailing slash; Next.js rewrites /api/v1/* to it)
# Leave API_PROXY_TARGET unset for local development.
API_PROXY_TARGET=

# MySQL (XAMPP) — Prisma connection string
# Default XAMPP: user root, no password, port 3306
DATABASE_URL="mysql://root@localhost:3306/nexus_commerce"

# If your XAMPP MySQL has a password:
# DATABASE_URL="mysql://root:yourpassword@localhost:3306/nexus_commerce"

# JWT  (production refuses to start with missing/short/placeholder secrets: use 32+ random chars,
# e.g. `openssl rand -base64 48`, and make JWT_SECRET, JWT_REFRESH_SECRET and COOKIE_SECRET all different)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=your-cookie-secret-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=noreply@nexuscommerce.io

# AI (OpenAI - optional)
OPENAI_API_KEY=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Rate Limiting (production only — disabled in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Seed script (`npm run seed --workspace=@nexus/api`) DELETES ALL DATA, then inserts demo data.
# - Local DB (localhost / XAMPP / docker-compose): works as before.
# - Any other database, or NODE_ENV=production: it refuses to run unless you deliberately set, for that one run only:
#     ALLOW_DESTRUCTIVE_SEED=true  SEED_ADMIN_PASSWORD=<strong unique value>  SEED_CUSTOMER_PASSWORD=<strong unique value>
#   (do not store these in .env or commit them)

# Database safety (scripts/db-guard.mjs): destructive Prisma commands (migrate reset/dev, db push, ...) run only against a
# LOCAL database outside production. To override against another database, for ONE command only, set both:
#   ALLOW_DESTRUCTIVE_DB=true  CONFIRM_DATABASE_HOST=<the exact database host>
# Take and verify a backup first (docs/DATABASE.md).

# API logging: console only by default. Set true to also write logs/error.log and logs/combined.log
# (needs a writable directory; most container hosts have none).
LOG_TO_FILE=false

# CLIENT_URL may list several origins separated by commas (no path, no trailing slash in production):
#   CLIENT_URL=https://shop.example.com,https://www.example.com

# --- Hosted MySQL with a private CA (Aiven). Placeholders only; check the real value with `npm run db:check-url`.
# Prisma's default sslaccept=accept_invalid_certs encrypts but does NOT verify the server; use strict plus the CA file.
# sslcert must be an ABSOLUTE path inside the container (the runtime image has no prisma/ folder for relative paths).
#   DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>?sslaccept=strict&sslcert=/app/apps/api/certs/aiven-ca.pem&connection_limit=5&connect_timeout=30
